{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroborostechnologies/platmark/catalog/catalog-v1.schema.json",
  "title": "Platmark layer catalog, schema version 1",
  "description": "The assembled catalog-v1.json. Entries refer to each other by key: a dataset names a provider, licence and coverage; a layer names a dataset and a group. Values with more than one kind carry a \"type\". Fields left out take the app's defaults.",
  "x-platmark-kinds": {
    "source": ["xyzRaster", "arcGISTiled", "arcGISMapExport", "arcGISImageExport", "wms", "wmts", "vectorTiles", "rasterDEM", "geoJSON", "composite"],
    "render": ["raster", "hillshade", "fill", "line", "dataDrivenFill", "points"],
    "discovery": ["fixed", "monthlyClock", "wayback", "imageCatalog", "regional", "serviceSet"],
    "category": ["baseMap", "topography", "hydrology", "geology", "historical", "boundaries", "aviation"],
    "cadence": ["monthly", "yearly", "irregular", "byPlace"],
    "style": ["remote", "bundled"],
    "placement": ["aboveStyle", "belowStyleLabels"],
    "cachePolicy": ["standardDiskCache", "memoryOnly", "disallowed"],
    "wmsVersion": ["1.1.1", "1.3.0"],
    "demEncoding": ["terrarium", "mapbox"],
    "useStatus": ["clear", "termsUnstated", "restricted"]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogRevision", "datasets", "layers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogRevision": {"type": "integer", "minimum": 1, "description": "Only increases. Written as YYYYMMDDNN by convention."},
    "providers": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/provider"}},
    "licenses": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/inlineLicense"}},
    "coverages": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/coverageEntry"}},
    "datasets": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/dataset"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
    "baseMaps": {"type": "array", "items": {"$ref": "#/$defs/baseMap"}}
  },
  "$defs": {
    "key": {"type": "string", "minLength": 1},
    "text": {"type": "string"},
    "url": {"type": "string", "minLength": 1},
    "date": {
      "description": "\"YYYY\", \"YYYY-MM\" or \"YYYY-MM-DD\": only as precise as the date is.",
      "type": "string",
      "pattern": "^[1-9][0-9]{3}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "rect": {
      "description": "[minLongitude, minLatitude, maxLongitude, maxLatitude], as GeoJSON's bbox.",
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "color": {"description": "\"#RRGGBB\" or \"#RGB\"; the # may be left out.", "type": "string", "pattern": "^#?([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$"},
    "zoom": {"type": "number", "minimum": 0, "maximum": 22},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "tileSize": {"type": "integer", "minimum": 1},
    "pixelRatio": {"type": "integer", "minimum": 1},
    "level": {"type": "integer", "minimum": 0, "maximum": 30},
    "query": {"type": "object", "additionalProperties": {"type": "string"}},

    "sourceKind": {"enum": ["xyzRaster", "arcGISTiled", "arcGISMapExport", "arcGISImageExport", "wms", "wmts", "vectorTiles", "rasterDEM", "geoJSON", "composite"]},
    "renderKind": {"enum": ["raster", "hillshade", "fill", "line", "dataDrivenFill", "points"]},
    "discoveryKind": {"enum": ["fixed", "monthlyClock", "wayback", "imageCatalog", "regional", "serviceSet"]},
    "styleKind": {"enum": ["remote", "bundled"]},
    "category": {"enum": ["baseMap", "topography", "hydrology", "geology", "historical", "boundaries", "aviation"]},
    "cadence": {"enum": ["monthly", "yearly", "irregular", "byPlace"]},
    "placement": {"enum": ["aboveStyle", "belowStyleLabels"]},
    "cachePolicy": {"enum": ["standardDiskCache", "memoryOnly", "disallowed"]},
    "wmsVersion": {"enum": ["1.1.1", "1.3.0"]},
    "demEncoding": {"enum": ["terrarium", "mapbox"]},

    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "abbreviation", "officialURL", "summary"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "abbreviation": {"$ref": "#/$defs/text"},
        "officialURL": {"$ref": "#/$defs/url"},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "inlineLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/url"}}
    },
    "license": {
      "description": "A key into licenses, or the licence in full.",
      "oneOf": [{"$ref": "#/$defs/key"}, {"$ref": "#/$defs/inlineLicense"}]
    },
    "inlineCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rects"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "rects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rect"}}
      }
    },
    "coverageEntry": {
      "description": "A coverage as the coverages table holds it: the coverage in full, or \"global\".",
      "oneOf": [{"const": "global"}, {"$ref": "#/$defs/inlineCoverage"}]
    },
    "coverage": {
      "description": "A key into coverages, \"global\", or the coverage in full.",
      "oneOf": [{"$ref": "#/$defs/key"}, {"$ref": "#/$defs/inlineCoverage"}]
    },
    "useStatus": {
      "oneOf": [
        {"enum": ["clear", "termsUnstated"]},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["restricted"],
          "properties": {"restricted": {"type": "string", "description": "Why the dataset is held back from shipping builds."}}
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "summary", "serviceURL", "attribution", "license", "coverage"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "provider": {"$ref": "#/$defs/key"},
        "summary": {"$ref": "#/$defs/text"},
        "officialURL": {"$ref": "#/$defs/url"},
        "serviceURL": {"$ref": "#/$defs/text"},
        "attribution": {"$ref": "#/$defs/text"},
        "license": {"$ref": "#/$defs/license"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "cachePolicy": {"$ref": "#/$defs/cachePolicy", "default": "standardDiskCache"},
        "requiresBackendProxy": {"type": "boolean", "default": false},
        "useStatus": {"$ref": "#/$defs/useStatus", "default": "clear"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "systemImage", "explanation"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "title": {"$ref": "#/$defs/text"},
        "systemImage": {"$ref": "#/$defs/text"},
        "explanation": {"$ref": "#/$defs/text"}
      }
    },

    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/sourceKind"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "xyzRaster"}}}, "then": {"$ref": "#/$defs/xyzRasterSource"}},
        {"if": {"properties": {"type": {"const": "arcGISTiled"}}}, "then": {"$ref": "#/$defs/arcGISTiledSource"}},
        {"if": {"properties": {"type": {"const": "arcGISMapExport"}}}, "then": {"$ref": "#/$defs/arcGISMapExportSource"}},
        {"if": {"properties": {"type": {"const": "arcGISImageExport"}}}, "then": {"$ref": "#/$defs/arcGISImageExportSource"}},
        {"if": {"properties": {"type": {"const": "wms"}}}, "then": {"$ref": "#/$defs/wmsSource"}},
        {"if": {"properties": {"type": {"const": "wmts"}}}, "then": {"$ref": "#/$defs/wmtsSource"}},
        {"if": {"properties": {"type": {"const": "vectorTiles"}}}, "then": {"$ref": "#/$defs/vectorTilesSource"}},
        {"if": {"properties": {"type": {"const": "rasterDEM"}}}, "then": {"$ref": "#/$defs/rasterDEMSource"}},
        {"if": {"properties": {"type": {"const": "geoJSON"}}}, "then": {"$ref": "#/$defs/geoJSONSource"}},
        {"if": {"properties": {"type": {"const": "composite"}}}, "then": {"$ref": "#/$defs/compositeSource"}}
      ]
    },
    "xyzRasterSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "urlTemplate"],
      "properties": {
        "type": {"const": "xyzRaster"},
        "urlTemplate": {"$ref": "#/$defs/url", "description": "Contains {z}, {x} and {y}."},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256},
        "maximumLevel": {"$ref": "#/$defs/level"}
      }
    },
    "arcGISTiledSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "serviceURL"],
      "properties": {
        "type": {"const": "arcGISTiled"},
        "serviceURL": {"$ref": "#/$defs/url", "description": "The MapServer or ImageServer root; tiles are <serviceURL>/tile/{z}/{y}/{x}."},
        "fileExtension": {"type": "string"},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256},
        "maximumLevel": {"$ref": "#/$defs/level"}
      }
    },
    "arcGISExportSource": {
      "description": "Shared by arcGISMapExport (the service's /export) and arcGISImageExport (/exportImage).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "serviceURL"],
      "properties": {
        "type": {"enum": ["arcGISMapExport", "arcGISImageExport"]},
        "serviceURL": {"$ref": "#/$defs/url"},
        "visibleLayers": {"type": "string"},
        "mosaicRule": {"type": "string"},
        "renderingRule": {"type": "string"},
        "imageFormat": {"type": "string", "default": "png32"},
        "transparent": {"type": "boolean", "default": true},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256},
        "pixelRatio": {"$ref": "#/$defs/pixelRatio", "default": 2},
        "additionalQuery": {"$ref": "#/$defs/query"}
      }
    },
    "arcGISMapExportSource": {"$ref": "#/$defs/arcGISExportSource", "properties": {"type": {"const": "arcGISMapExport"}}},
    "arcGISImageExportSource": {"$ref": "#/$defs/arcGISExportSource", "properties": {"type": {"const": "arcGISImageExport"}}},
    "wmsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "endpoint", "layers", "version"],
      "properties": {
        "type": {"const": "wms"},
        "endpoint": {"$ref": "#/$defs/url"},
        "layers": {"type": "string"},
        "version": {"$ref": "#/$defs/wmsVersion"},
        "styles": {"type": "string", "default": ""},
        "imageFormat": {"type": "string", "default": "image/png"},
        "transparent": {"type": "boolean", "default": true},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256},
        "pixelRatio": {"$ref": "#/$defs/pixelRatio", "default": 2},
        "additionalQuery": {"$ref": "#/$defs/query"}
      }
    },
    "wmtsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "urlTemplate"],
      "properties": {
        "type": {"const": "wmts"},
        "urlTemplate": {"$ref": "#/$defs/url", "description": "RESTful template with {z}, {y} and {x} in the publisher's own order."},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256},
        "maximumLevel": {"$ref": "#/$defs/level"}
      }
    },
    "vectorTilesSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "urlTemplate", "sourceLayer"],
      "properties": {
        "type": {"const": "vectorTiles"},
        "urlTemplate": {"$ref": "#/$defs/url"},
        "sourceLayer": {"type": "string"}
      }
    },
    "rasterDEMSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "urlTemplate", "encoding"],
      "properties": {
        "type": {"const": "rasterDEM"},
        "urlTemplate": {"$ref": "#/$defs/url"},
        "encoding": {"$ref": "#/$defs/demEncoding"},
        "tileSize": {"$ref": "#/$defs/tileSize", "default": 256}
      }
    },
    "geoJSONSource": {
      "description": "Point features the app reads itself rather than as tiles: a GeoJSON file, or a query whose URL holds {west}, {south}, {east} and {north}, filled with the area in view in degrees.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {"const": "geoJSON"},
        "url": {"$ref": "#/$defs/url"},
        "records": {
          "description": "For a response that isn't GeoJSON: where its list of flat records is, and which fields hold each record's coordinates. Every other plain field becomes a property.",
          "type": "object",
          "additionalProperties": false,
          "required": ["longitude", "latitude"],
          "properties": {
            "path": {"type": "string", "default": "", "description": "Dotted path to the list; empty when the response is the list."},
            "longitude": {"type": "string"},
            "latitude": {"type": "string"}
          }
        }
      }
    },
    "compositeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "members"],
      "properties": {
        "type": {"const": "composite"},
        "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compositeMember"}}
      }
    },
    "compositeMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "coverage", "attribution"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "attribution": {"$ref": "#/$defs/text"},
        "render": {"$ref": "#/$defs/render"},
        "minimumZoom": {"$ref": "#/$defs/zoom"},
        "maximumZoom": {"$ref": "#/$defs/zoom"}
      }
    },

    "render": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/renderKind"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "raster"}}}, "then": {"$ref": "#/$defs/rasterRender"}},
        {"if": {"properties": {"type": {"const": "hillshade"}}}, "then": {"$ref": "#/$defs/hillshadeRender"}},
        {"if": {"properties": {"type": {"const": "fill"}}}, "then": {"$ref": "#/$defs/fillRender"}},
        {"if": {"properties": {"type": {"const": "line"}}}, "then": {"$ref": "#/$defs/lineRender"}},
        {"if": {"properties": {"type": {"const": "dataDrivenFill"}}}, "then": {"$ref": "#/$defs/dataDrivenFillRender"}},
        {"if": {"properties": {"type": {"const": "points"}}}, "then": {"$ref": "#/$defs/pointsRender"}}
      ]
    },
    "rasterRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "raster"},
        "brightnessMin": {"type": "number", "default": 0},
        "brightnessMax": {"type": "number", "default": 1},
        "contrast": {"type": "number", "default": 0},
        "saturation": {"type": "number", "default": 0},
        "fadeDuration": {"type": "number", "minimum": 0, "default": 0}
      }
    },
    "hillshadeRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "hillshade"},
        "exaggeration": {"type": "number"},
        "shadowColor": {"$ref": "#/$defs/color"},
        "highlightColor": {"$ref": "#/$defs/color"},
        "accentColor": {"$ref": "#/$defs/color"}
      }
    },
    "fillRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color"],
      "properties": {
        "type": {"const": "fill"},
        "color": {"$ref": "#/$defs/color"},
        "outlineColor": {"$ref": "#/$defs/color"}
      }
    },
    "lineRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color"],
      "properties": {
        "type": {"const": "line"},
        "color": {"$ref": "#/$defs/color"},
        "width": {"type": "number", "minimum": 0, "default": 1}
      }
    },
    "pointsRender": {
      "description": "A dot at each point, and the labelField property written beside it from labelMinimumZoom.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color"],
      "properties": {
        "type": {"const": "points"},
        "color": {"$ref": "#/$defs/color"},
        "radius": {"type": "number", "exclusiveMinimum": 0, "default": 4},
        "outlineColor": {"oneOf": [{"$ref": "#/$defs/color"}, {"type": "null"}], "default": "#FFFFFF", "description": "null draws no outline."},
        "labelField": {"type": "string"},
        "labelMinimumZoom": {"$ref": "#/$defs/zoom", "default": 11}
      }
    },
    "dataDrivenFillRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "colorAttribute", "fallbackColor"],
      "properties": {
        "type": {"const": "dataDrivenFill"},
        "colorAttribute": {"type": "string"},
        "fallbackColor": {"$ref": "#/$defs/color"},
        "outlineColor": {"$ref": "#/$defs/color"},
        "outlineOpacity": {"$ref": "#/$defs/unit", "default": 1}
      }
    },

    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "date": {"$ref": "#/$defs/date"},
        "label": {"type": "string"},
        "detail": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "regionalEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "source", "extent"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "date": {"$ref": "#/$defs/date"},
        "label": {"type": "string"},
        "detail": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "extent": {"$ref": "#/$defs/rect"}
      }
    },
    "serviceSetMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "source", "serviceURL"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "date": {"$ref": "#/$defs/date"},
        "label": {"type": "string"},
        "detail": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "serviceURL": {"$ref": "#/$defs/url"},
        "filter": {"type": "string"},
        "yearField": {"type": "string"}
      }
    },
    "discovery": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/discoveryKind"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "fixed"}}}, "then": {"$ref": "#/$defs/fixedDiscovery"}},
        {"if": {"properties": {"type": {"const": "monthlyClock"}}}, "then": {"$ref": "#/$defs/monthlyClockDiscovery"}},
        {"if": {"properties": {"type": {"const": "wayback"}}}, "then": {"$ref": "#/$defs/waybackDiscovery"}},
        {"if": {"properties": {"type": {"const": "imageCatalog"}}}, "then": {"$ref": "#/$defs/imageCatalogDiscovery"}},
        {"if": {"properties": {"type": {"const": "regional"}}}, "then": {"$ref": "#/$defs/regionalDiscovery"}},
        {"if": {"properties": {"type": {"const": "serviceSet"}}}, "then": {"$ref": "#/$defs/serviceSetDiscovery"}}
      ]
    },
    "fixedDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "editions"],
      "properties": {
        "type": {"const": "fixed"},
        "editions": {"type": "array", "items": {"$ref": "#/$defs/edition"}}
      }
    },
    "monthlyClockDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "idPrefix", "firstMonth", "dayOfMonth", "publicationDelayDays", "source"],
      "properties": {
        "type": {"const": "monthlyClock"},
        "idPrefix": {"type": "string"},
        "firstMonth": {"$ref": "#/$defs/date"},
        "dayOfMonth": {"type": "integer", "minimum": 1, "maximum": 31},
        "substituteDays": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 31}
        },
        "publicationDelayDays": {"type": "integer", "minimum": 0},
        "detailPrefix": {"type": "string"},
        "source": {"$ref": "#/$defs/source", "description": "{date} in it stands for the pictured day, as yyyy-mm-dd."}
      }
    },
    "waybackDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "configURL", "tilemapURL", "tileRoot"],
      "properties": {
        "type": {"const": "wayback"},
        "configURL": {"$ref": "#/$defs/url"},
        "tilemapURL": {"$ref": "#/$defs/url"},
        "tileRoot": {"$ref": "#/$defs/url"}
      }
    },
    "imageCatalogDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "serviceURL", "yearField"],
      "properties": {
        "type": {"const": "imageCatalog"},
        "serviceURL": {"$ref": "#/$defs/url"},
        "yearField": {"type": "string"},
        "nameField": {"type": "string"},
        "matchWindow": {"type": "integer", "minimum": 0, "default": 5}
      }
    },
    "regionalDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "editions"],
      "properties": {
        "type": {"const": "regional"},
        "editions": {"type": "array", "items": {"$ref": "#/$defs/regionalEdition"}}
      }
    },
    "serviceSetDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "members"],
      "properties": {
        "type": {"const": "serviceSet"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/serviceSetMember"}}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "discovery"],
      "properties": {
        "range": {
          "description": "[first, last]. May be left out when the discovery is fixed or monthlyClock.",
          "type": "array",
          "items": {"$ref": "#/$defs/date"},
          "minItems": 2,
          "maxItems": 2
        },
        "cadence": {"$ref": "#/$defs/cadence"},
        "discovery": {"$ref": "#/$defs/discovery"},
        "preloadAllowance": {"type": "integer", "minimum": 0, "default": 2}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "category", "dataset"],
      "properties": {
        "id": {"$ref": "#/$defs/key", "description": "Permanent. Never reused for a different dataset."},
        "name": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "category": {"$ref": "#/$defs/category"},
        "dataset": {"$ref": "#/$defs/key"},
        "source": {"$ref": "#/$defs/source", "description": "May be left out by a dated layer whose discovery is fixed or monthlyClock; it then draws its newest date."},
        "render": {"$ref": "#/$defs/render", "default": {"type": "raster"}},
        "minimumZoom": {"$ref": "#/$defs/zoom", "default": 0},
        "maximumZoom": {"$ref": "#/$defs/zoom", "default": 22},
        "defaultOpacity": {"$ref": "#/$defs/unit", "default": 1},
        "group": {"$ref": "#/$defs/key"},
        "time": {"$ref": "#/$defs/time"}
      }
    },

    "style": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/styleKind"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "remote"}}}, "then": {"$ref": "#/$defs/remoteStyle"}},
        {"if": {"properties": {"type": {"const": "bundled"}}}, "then": {"$ref": "#/$defs/bundledStyle"}}
      ]
    },
    "remoteStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {"type": {"const": "remote"}, "url": {"$ref": "#/$defs/url"}}
    },
    "bundledStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {"type": {"const": "bundled"}, "name": {"type": "string", "minLength": 1}}
    },
    "baseMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "systemImage", "style", "datasets"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "name": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "systemImage": {"$ref": "#/$defs/text"},
        "style": {"$ref": "#/$defs/style"},
        "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}, "default": []},
        "datasets": {"type": "array", "items": {"$ref": "#/$defs/key"}},
        "placement": {"$ref": "#/$defs/placement", "default": "aboveStyle"}
      }
    }
  }
}
